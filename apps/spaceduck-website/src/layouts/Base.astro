---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  noindex?: boolean;
}

const {
  title = "Spaceduck — Your personal AI assistant, local or cloud",
  description = "Spaceduck is a personal AI assistant with persistent memory, autonomous tasks, and budget enforcement. Run locally with llama.cpp or connect to AWS Bedrock, Gemini, or OpenRouter.",
  keywords = "personal AI assistant, local AI, autonomous AI agent, llama.cpp, AI memory, AI scheduler, self-hosted AI, AI agent budget, AI task automation, open source AI assistant, Bedrock, Gemini, OpenRouter, agentic tools, AI skills",
  noindex = false,
} = Astro.props;

const ogImage = new URL("/og-image.svg", Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = "Spaceduck";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: Astro.site?.toString(),
  logo: new URL("/spaceduck-logo.png", Astro.site).toString(),
  sameAs: [
    "https://github.com/maziarzamani/spaceduck",
  ],
};

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: siteName,
  description,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  applicationCategory: "ProductivityApplication",
  operatingSystem: "macOS, Linux, Windows",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://github.com/maziarzamani/spaceduck/blob/main/LICENSE",
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.toString(),
  description,
};
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d12" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" href="/spaceduck-logo.png" />
    <link rel="apple-touch-icon" href="/spaceduck-logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Spaceduck" />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1"} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Spaceduck — your personal AI assistant" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Spaceduck — your personal AI assistant" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organizationJsonLd)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(softwareJsonLd)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteJsonLd)}
    />

    <style>
      body { font-family: "Inter", system-ui, -apple-system, sans-serif; }
    </style>
  </head>
  <body class="bg-surface text-text-body">
    <slot />
  </body>
</html>
